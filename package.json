{
  "name": "playwright_framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript + BDD test automation framework with API-driven test setup, API tests, CI and Allure reporting",
  "private": true,
  "scripts": {
    "bdd:gen": "bddgen",
    "test": "npm run bdd:gen && playwright test --project=api --project=chromium",
    "test:api": "playwright test --project=api",
    "test:e2e": "npm run bdd:gen && playwright test --project=chromium",
    "test:smoke": "npm run bdd:gen && playwright test --project=chromium --grep @smoke",
    "test:cross-browser": "npm run bdd:gen && playwright test --project=chromium --project=firefox",
    "test:local": "cross-env ENV=local npm run test",
    "test:staging": "cross-env ENV=staging npm run test",
    "test:prod": "cross-env ENV=production npm run test",
    "test:custom": "cross-env ENV=custom npm run test",
    "test:headed": "npm run bdd:gen && playwright test --project=chromium --headed",
    "test:debug": "npm run bdd:gen && playwright test --project=chromium --debug",
    "test:ui": "npm run bdd:gen && playwright test --ui",
    "report:html": "playwright show-report reports/html",
    "report:allure": "allure generate reports/allure-results -o reports/allure-report --clean && allure open reports/allure-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "bdd",
    "cucumber",
    "test-automation",
    "api-testing",
    "allure"
  ],
  "author": "Özgür Ertop",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.9.0",
    "cross-env": "^10.1.0",
    "playwright-bdd": "^9.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
